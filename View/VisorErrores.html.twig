{% extends "Master/MenuBgTemplate.html.twig" %}

{% block body %}
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>
                <i class="fa-solid fa-triangle-exclamation me-1"></i> {{ trans('visor-errores') }}
            </h1>
        </div>
        <ul class="nav nav-tabs" id="ErrorsTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="crash-errors-tab" data-bs-toggle="tab" data-bs-target="#crash-errors-tab-pane" type="button" role="tab" aria-controls="crash-errors-tab-pane" aria-selected="true">{{ trans('visor-errores-criticos') }}</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="errors-logs-tab" data-bs-toggle="tab" data-bs-target="#errors-logs-tab-pane" type="button" role="tab" aria-controls="errors-logs-tab-pane" aria-selected="false">{{ trans('visor-errores-logs') }}</button>
            </li>
        </ul>
        <div class="tab-content mt-3" id="ErrorsTabContent">
            <div class="tab-pane fade show active" id="crash-errors-tab-pane" role="tabpanel" aria-labelledby="crash-errors-tab" tabindex="0">
                {% if fsc.datosArchivos %}
                    <form method="post" class="d-flex justify-content-end align-items-center my-2"
                          onsubmit="return confirm('{{ trans('visor-errores-eliminar-todos-confirm')|e('js') }}');">
                        <input type="hidden" name="action" value="delete-all">
                        <input type="hidden" name="multireqtoken" value="{{ formToken(false) }}">
                        <button type="submit" class="btn btn-secondary position-relative">
                            <i class="fa-solid fa-trash-alt me-1"></i> {{ trans('visor-errores-eliminar-todos') }}
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                {{ fsc.datosArchivos | length }}
                            </span>
                        </button>
                    </form>
                    {% for datos in fsc.datosArchivos %}
                        <div class="card shadow mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <a href="https://facturascripts.com/errores/{{ datos.hash|url_encode }}" target="_blank" rel="noopener">
                                    🚨 {{ datos.hash }}
                                </a>
                                <form method="post" class="d-flex align-items-center"
                                      onsubmit="return confirm('{{ trans('visor-errores-eliminar-confirm')|e('js') }}');">
                                    <span class="me-3">{{ datos.fecha }}</span>
                                    <input type="hidden" name="action" value="delete">
                                    <input type="hidden" name="hash" value="{{ datos.hash }}">
                                    <input type="hidden" name="multireqtoken" value="{{ formToken(false) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="{{ trans('delete') }}">
                                        <i class="fa-solid fa-trash-alt"></i>
                                    </button>
                                </form>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <strong>{{ trans('message') }}:</strong><br>
                                    {{ datos.datos.message|nl2br }}
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <strong>{{ trans('file') }}:</strong> {{ datos.datos.file }}
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong>{{ trans('line') }}:</strong> {{ datos.datos.line }}
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong>{{ trans('url') }}:</strong> {{ datos.datos.url }}
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong>{{ trans('ip') }}:</strong> {{ datos.datos.ip }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="text-white text-bg-warning rounded-5 text-center p-1">
                        {{ trans('no-data') }}
                    </div>
                {% endif %}
            </div>
            <div class="tab-pane fade" id="errors-logs-tab-pane" role="tabpanel" aria-labelledby="errors-logs-tab" tabindex="0">
                {% if fsc.logsErrors %}
                    <div class="d-flex justify-content-between align-items-center my-2">
                        <p><em>{{ trans('visor-errores-ultimos-logs') }} <a href="{{ asset('ListLogMessage') }}" target="_blank">{{ trans('logs') }}</a></em></p>
                    </div>
                    {% for datos in fsc.logsErrors %}
                        <div class="card shadow mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="me-3">{{ datos.time }}</span>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <strong>{{ trans('message') }}:</strong><br>
                                    {{ datos.message }}
                                </div>
                                <div class="mb-3">
                                    <strong>{{ trans('visor-errores-contexto') }}:</strong><br>
                                    <pre class="bg-body-tertiary p-3 border rounded">
                                        {{- datos.context|json_encode(constant('JSON_PRETTY_PRINT')) -}}
                                    </pre>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <strong>{{ trans('visor-errores-canal') }}:</strong> {{ datos.channel }}
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong>URI:</strong> {{ datos.uri }}
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong>{{ trans('ip') }}:</strong> {{ datos.ip }}
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong>{{ trans('user') }}:</strong> {{ datos.nick }}
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong>{{ trans('model') }}:</strong> {{ datos.model }}
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong>{{ trans('visor-errores-codigo-modelo') }}:</strong> {{ datos.modelcode }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="text-white text-bg-warning rounded-5 text-center p-1">
                        {{ trans('no-data') }}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
